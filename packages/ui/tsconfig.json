{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"noEmit": true,
		"verbatimModuleSyntax": true,
		"allowJs": true,
		"checkJs": true,
		"types": ["node"]
	},
	"include": ["src", "vitest.config.ts"]
}
