		"sync": "node scripts/sync.mjs"
	},
	"devDependencies": {
		"@types/node": "^26",
		"ajv": "8.20.0",
		"ajv-formats": "3.0.1",
		"typescript": "^6.0.3",
		"vitest": "^5.1.1"
	}
}
