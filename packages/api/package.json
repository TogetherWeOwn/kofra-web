{
	"name": "@kofra/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./demo": {
			"types": "./src/demo/index.ts",
			"default": "./src/demo/index.ts"
		},
		"./errors.json": "./vendor/errors.json",
		"./testing": {
			"types": "./src/testing/contract.ts",
			"default": "./src/testing/contract.ts"
		}
