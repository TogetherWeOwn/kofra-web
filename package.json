{
	"name": "kofra-web",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.34.9",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"check": "pnpm -r --workspace-concurrency=1 run check",
		"test:unit": "pnpm -r run test:unit",
		"build": "pnpm -r run build",
		"test:e2e": "pnpm -r --workspace-concurrency=1 run test:e2e"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"svelte": "^5.58.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0"
	}
}
