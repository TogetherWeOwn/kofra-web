{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Placeholder name. Not deployed from this file by CI: there is no deploy workflow
	// until the owner approves one; production values will come from the CI environment.
	"name": "kofra-site",
	"compatibility_date": "2026-11-19",
	// No public workers.dev or preview URL.
	"workers_dev": false,
	"preview_urls": false,
	"vars": {
		// Early-access waitlist (docs/waitlist.md). Off until a privacy policy is in force.
		// Enabling also needs the D1 and email bindings and three secrets; without them the
		// endpoints answer 404 (src/lib/server/waitlist-env.ts).
		// The build reads these too: the form is rendered only when enabled with a site key.
		"WAITLIST_ENABLED": "false",
		"WAITLIST_FROM": "",
		"TURNSTILE_SITE_KEY": ""
	},
	// Per-IP limit for the waitlist form and confirmation (5 requests a minute).
	"ratelimits": [
		{
			"name": "WAITLIST_RATE",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 }
		}
	]
}
