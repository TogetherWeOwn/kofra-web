{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Placeholder name. The staging copy is deployed by hand under its own name and host;
	// there is no deploy workflow until the owner approves one.
	"name": "kofra-console",
	"compatibility_date": "2026-11-19",
	// No public workers.dev or preview URL.
	"workers_dev": false,
	"preview_urls": false,
	"vars": {
		// The data source. "demo": an in-memory API with per-visitor sample data and no sign-in.
		// "tenant0": the operator's own storage account, behind Cloudflare Access, which also
		// needs the settings, secrets and service binding listed in
		// docs/console-owner-workspace.md. Any other value, or a missing setting, makes every
		// page answer 503 (see src/lib/server/config.ts), so a build never serves real data
		// without its sign-in.
		"CONSOLE_DATA": "demo",
		// "off" or "test". "test" also needs the STRIPE_SECRET_KEY secret (a test-mode key) and
		// STRIPE_PRICE_ID; see src/lib/server/stripe.ts. Always off in tenant0.
		"BILLING": "off",
		"STRIPE_PRICE_ID": "",
		"STRIPE_PORTAL_CUSTOMER": ""
	}
}
